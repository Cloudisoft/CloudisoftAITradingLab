# Copy to .env (never commit .env). All trading-safety flags default to the SAFE value.
POSTGRES_PASSWORD=change-me
CLAB_ENVIRONMENT=development
CLAB_JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
CLAB_CREDENTIAL_ENCRYPTION_KEY=generate-with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CLAB_OWNER_EMAIL=owner@example.com
# argon2 hash: uv run python -c "from cloudisoft_lab.core.security import hash_password;print(hash_password('your-password'))"
CLAB_OWNER_PASSWORD_HASH=
CLAB_PAPER_STARTING_BALANCE_USD=5
CLAB_PAPER_LOOP_SECONDS=300
CLAB_MARKET_DATA_SOURCE=synthetic   # synthetic | csv_replay (upload candles in Market Data)
CLAB_NEWS_FEEDS=[]                   # JSON list of permitted RSS/Atom feed URLs
CLAB_OWNER_WEBHOOK_URL=              # optional HTTPS webhook for owner alerts
CLAB_AUTO_MIGRATE=true
# Optional: enables Claude-powered research agents (otherwise rule-based, zero inference cost).
# Set it as a Railway/host variable; never commit it.
# ANTHROPIC_API_KEY=
# ---- DO NOT CHANGE without completing IMPLEMENTATION_ROADMAP.md "Path to live trading" ----
CLAB_LIVE_TRADING_ENABLED=false
CLAB_OWNER_LIVE_TRADING_APPROVED=false
CLAB_KILL_SWITCH_ENGAGED=false
